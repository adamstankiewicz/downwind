{
  "name": "downwind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "smoke": "node e2e/smoke.mjs",
    "check-docs": "CHECK_DOCS=1 vitest run src/refs/__tests__/docs.live.test.ts",
    "eval:ask": "vitest run evals/ask/run.test.ts --reporter=dot --silent=false"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-fsrs": "^5.2.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.12"
  }
}
